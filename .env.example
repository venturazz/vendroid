# ===== Android Remote Runner - shared by systemd (EnvironmentFile) and Docker Compose / Coolify =====
# Copy to .env (compose) or /etc/android-runner.env (systemd). Do not commit real secrets.

# --- Server ---------------------------------------------------------------
PORT=3080
# Docker/Coolify only: bind address in host-network mode (default 0.0.0.0).
# RUNNER_BIND_HOST=127.0.0.1
# Bind address. 127.0.0.1 when a proxy runs on the same host (systemd + Caddy/Nginx).
# 0.0.0.0 in Docker (and block the port in the firewall / OCI security list).
HOST=127.0.0.1
# Set true only behind a proxy that overwrites X-Forwarded-For (used for login throttling).
TRUST_PROXY=false

# --- Auth (REQUIRED) ----------------------------------------------------------
# Generate: openssl rand -base64 24
AUTH_PASSWORD=change-me-to-a-long-random-password
# Optional bearer token for scripts/curl (>=16 chars). Leave empty to disable.
API_TOKEN=
# Optional; auto-generated and persisted in DATA_DIR if empty.
SESSION_SECRET=
SESSION_TTL_HOURS=24
# Leave unset for auto (Secure cookie when the request arrives via HTTPS / X-Forwarded-Proto).
# COOKIE_SECURE=true

# --- Android workspace ---------------------------------------------------------
# systemd only (Docker always uses /workspace/android-project on the `project` volume)
ANDROID_PROJECT_PATH=/srv/android-project
APP_MODULE=app
DEFAULT_PACKAGE_NAME=com.example.app
# Phone address on the ZeroTier / WireGuard tunnel: <tunnel_ip>:<adb_tcp_port>
DEFAULT_DEVICE_ADDRESS=10.147.17.50:5555
# Docker only: clone the project on first start if the volume is empty.
# PROJECT_GIT_URL=https://github.com/you/your-android-app.git
# PROJECT_GIT_BRANCH=main

# --- Toolchain (systemd paths; the Docker image sets its own) -------------------------
ANDROID_HOME=/opt/android-sdk
GRADLE_USER_HOME=/var/lib/android-runner/.gradle
DATA_DIR=/var/lib/android-runner/data
# JAVA_HOME=/usr/lib/jvm/java-17-openjdk-arm64
# ADB_BIN=/usr/bin/adb
# aapt2: auto | apt | box64 | path  (see docs/RUNBOOK.md "ARM64 aapt2")
AAPT2_MODE=auto
# AAPT2_BINARY=/opt/aapt2/aapt2
# SDK packages installed by bootstrap-sdk.sh (match your compileSdk / buildToolsVersion)
SDK_PACKAGES="platforms;android-35 build-tools;35.0.0"
SDK_AUTO_INSTALL=true

# --- Resource limits (4 OCPU / 24 GB) ------------------------------------------------
# Defaults are applied by the runner; uncomment only to override.
# GRADLE_JVM_ARGS=-Xmx4096m -XX:+UseG1GC
# KOTLIN_DAEMON_JVM_ARGS=-Xmx3072m
GRADLE_MAX_WORKERS=3
BUILD_TIMEOUT_MIN=45
MAX_BUILD_HISTORY=30

# --- AI services (keep bound to 127.0.0.1 on the host) --------------------------------
NINE_ROUTER_URL=http://127.0.0.1:20128/v1
NINE_ROUTER_API_KEY=
NINE_ROUTER_MODEL=auto
HERMES_WEBHOOK_URL=http://127.0.0.1:8644/webhook
HERMES_WEBHOOK_SECRET=
