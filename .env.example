# ===== Vendroid configuration =====
# Docker Compose / Coolify: copy to .env (or paste into Coolify's Environment Variables).
# systemd: lives in /etc/android-runner.env (created by runner/scripts/setup-ubuntu-arm64.sh).
#
# Every value is optional. Projects are created/cloned from the Project Hub in the browser.

# --- Most people set ---------------------------------------------------------------------------
# Dashboard password. Leave empty to auto-generate one (printed in the logs, saved in DATA_DIR/initial_password).
AUTH_PASSWORD=
# Phone address on the ZeroTier / WireGuard tunnel: <tunnel_ip>:<adb_tcp_port>. Auto-reconnected.
DEFAULT_DEVICE_ADDRESS=
# GitHub/GitLab token for cloning private repos and pushing (fine-grained: Contents read/write).
# Given to git through GIT_ASKPASS only; never stored in .git/config.
GIT_TOKEN=
GIT_USER_NAME=Vendroid
GIT_USER_EMAIL=vendroid@localhost

# --- Agents (Hermes Agent via MCP / REST) --------------------------------------------------------
# Bearer token for POST /mcp and /api/agent/tools/*. Empty = generated, shown in Settings → Agents.
MCP_TOKEN=
# false = agents get read-only tools (no file edits, commits, pushes)
MCP_ALLOW_WRITE=true

# --- AI coding assistant -------------------------------------------------------------------------
AI_CODE_MAX_TOKENS=8000
AI_CODE_CONTEXT_CHARS=120000

# --- Optional first project (v1 style) -------------------------------------------------------------
# Cloned on first start (Docker into /workspace/<repo>, systemd by the setup script).
PROJECT_GIT_URL=
PROJECT_GIT_BRANCH=main
# Package used for a v1 project that has no applicationId detected (normally read from Gradle files)
DEFAULT_PACKAGE_NAME=

# --- Push-to-deploy (optional) -------------------------------------------------------------------
# Set a secret, then add a webhook in GitHub/Gitea/GitLab: https://<your-domain>/api/hooks/git
# (content type application/json, same secret). Each push pulls, builds, installs and launches.
GIT_WEBHOOK_SECRET=
# Only build pushes to this branch (empty = any branch)
AUTO_BUILD_BRANCH=
AUTO_BUILD_TASK=assembleDebug
AUTO_BUILD_INSTALL=true
AUTO_BUILD_LAUNCH=true
AUTO_BUILD_NOTIFY_HERMES=false

# --- AI services (keep them bound to 127.0.0.1 on the host) ---------------------------------------
NINE_ROUTER_URL=http://127.0.0.1:20128/v1
NINE_ROUTER_API_KEY=
NINE_ROUTER_MODEL=auto
# Hermes webhook route (platforms.webhook.extra.routes.vendroid, signature: generic)
HERMES_WEBHOOK_URL=http://127.0.0.1:8644/webhooks/vendroid
HERMES_WEBHOOK_SECRET=
# Hermes API server (chat with Hermes inside the IDE). Publish Hermes's 8642 to 127.0.0.1 and use its API_SERVER_KEY.
HERMES_API_URL=
HERMES_API_KEY=
HERMES_API_MODEL=hermes-agent

# --- Release signing (optional) ------------------------------------------------------------------
# Signs assembleRelease without touching the project's build files (AGP injected signing).
# Docker: put the keystore in the project volume or data volume, e.g. /data/release.jks
RELEASE_KEYSTORE_PATH=
RELEASE_KEYSTORE_PASSWORD=
RELEASE_KEY_ALIAS=
RELEASE_KEY_PASSWORD=

# --- Server --------------------------------------------------------------------------------------
PORT=3080
# systemd: bind address (keep 127.0.0.1 behind Caddy/Nginx). Docker: RUNNER_BIND_HOST (default 127.0.0.1).
HOST=127.0.0.1
# true when a reverse proxy sets X-Forwarded-For (used for login throttling)
TRUST_PROXY=true
# Optional bearer token for scripts/CI (>= 16 chars): curl -H "Authorization: Bearer $API_TOKEN" ...
API_TOKEN=
SESSION_TTL_HOURS=168
# SESSION_SECRET=   (auto-generated and persisted when empty)

# --- Android workspace & toolchain ---------------------------------------------------------------
# Where projects live. Docker: /workspace (the `project` volume). systemd default: /var/lib/android-runner/workspaces
# WORKSPACES_DIR=/var/lib/android-runner/workspaces
# v1 single-project path; still shown as a project if set (linked into WORKSPACES_DIR)
# ANDROID_PROJECT_PATH=/srv/android-project
ADB_AUTO_RECONNECT=true
# systemd paths (the Docker image sets its own)
ANDROID_HOME=/opt/android-sdk
GRADLE_USER_HOME=/var/lib/android-runner/.gradle
DATA_DIR=/var/lib/android-runner/data
# Match your compileSdk / buildToolsVersion; AGP can also download missing ones (licenses are pre-accepted).
SDK_PACKAGES="platforms;android-36 build-tools;36.0.0"
SDK_AUTO_INSTALL=true
# aarch64 aapt2: auto (box64 + Google's aapt2, else prebuilt) | box64 | prebuilt | path | apt
AAPT2_MODE=auto
# AAPT2_BINARY=/opt/aapt2/aapt2
# JDK that runs Gradle in Docker (17 or 21)
JAVA_VERSION=17

# --- Resource limits (4 OCPU / 24 GB) ------------------------------------------------------------
GRADLE_JVM_ARGS=-Xmx4096m -XX:+UseG1GC -Dfile.encoding=UTF-8
KOTLIN_DAEMON_JVM_ARGS=-Xmx3072m
GRADLE_MAX_WORKERS=3
BUILD_TIMEOUT_MIN=45
MAX_BUILD_HISTORY=30
